{
  "expo": {
    "name": "Salone Companion",
    "slug": "salone-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "salone",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/kuziini-logo.png",
    "splash": {
      "image": "./assets/kuziini-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salone.companion",
      "icon": "./assets/kuziini-logo.png"
    },
    "android": {
      "package": "com.salone.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/kuziini-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/kuziini-logo.png"
    },
    "plugins": []
  }
}
