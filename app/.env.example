# Copy to app/.env and fill in. These are loaded by Expo at build time.
# Both keys are PUBLIC — the anon key is safe to ship in the binary because
# RLS policies enforce per-user data access.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...replace_me...
